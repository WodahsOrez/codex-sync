# Allow only reviewed backup categories.
*
!/.gitignore
!/.gitattributes
!/README.md
!/backup-manifest.json
!/codex/
/codex/*
!/codex/AGENTS.md
!/codex/config.toml
!/codex/skills/
!/codex/skills/**
!/portable/
!/portable/AGENTS.md
!/portable/config.toml
!/plugin-skills/
!/plugin-skills/**
!/agent-skills/
!/agent-skills/**

# Credentials and generated files never belong in a skills snapshot.
**/auth.json
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/node_modules/
**/__pycache__/
**/*.pyc
**/.DS_Store
